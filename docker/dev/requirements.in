# Python tools baked into the dev image. Regenerate the lock after an edit;
# set --exclude-newer to a date at least three days back; certifi resolves
# past it because older releases trust compromised emSign roots (PYSEC-2026-4320);
# filelock resolves past it for the 4.2.1 fixes (GHSA-v4x8-3wr5-3wq8 and others);
# virtualenv now for the 21.14.13 fix (GHSA-cx6f-vjhg-g3cc):
#   uv pip compile --generate-hashes --universal --python-version 3.12 \
#     --exclude-newer 2026-10-08T00:00:00Z \
#     --exclude-newer-package certifi=2026-10-21T00:00:00Z \
#     --exclude-newer-package filelock=2026-10-18T00:00:00Z \
#     --exclude-newer-package virtualenv=2026-10-23T00:00:00Z \
#     --output-file docker/dev/requirements.txt docker/dev/requirements.in
pre-commit==4.6.2
