# Lists every anchore/sbom-action or publish-sbom step that would attach release assets
# (upload-release-assets not disabled) in a job whose token lacks contents: write.
# The action attaches assets only on a release event or a push to a tag; a push filtered to
# branches alone never sees a tag, unless the step moves release-ref-prefix. A pull_request-only
# workflow is skipped.
# A workflow_call workflow cannot see its caller, so the called job must state permissions: contents: write.
# Runner input names and action refs are case-insensitive and core.getInput trims whitespace, so
# the rule normalises once and allow-lists only upload-release-assets == false and default release-ref-prefix.
# Action inputs can also arrive as INPUT_<NAME> in workflow, job, or step env, so those scopes are
# collected too; env alone never disables upload-release-assets and an env that is no map counts as unsafe.
explode(.)
| (.permissions // {}) as $wp
| [{"key": "input_upload-release-assets", "value": "?"}, {"key": "input_release-ref-prefix", "value": "?"}] as $opaque
| (((.env // {}) | select(tag == "!!map") | to_entries) // $opaque) as $we
| ((.on | select(tag == "!!map") | keys) // (.on | [.] | flatten)) as $events
| ((.on | select(tag == "!!map") | .push) // {}) as $push
| ($events | any_c(. == "release" or . == "workflow_call")) as $release
| ($events | any_c(. == "push")) as $pushes
| ($push | ((has("branches") or has("branches-ignore")) and ((has("tags") or has("tags-ignore")) | not))) as $branch_only
| select($release or $pushes)
| .jobs | to_entries | .[] | .key as $job
| (.value.permissions // $wp) as $p
| select(($p == "write-all" or ($p | tag) == "!!map" and $p.contents == "write") | not)
| (((.value.env // {}) | select(tag == "!!map") | to_entries) // $opaque) as $je
| .value.steps // [] | .[]
| ((.uses // "") | downcase) as $uses
| select($uses | test("^anchore/sbom-action(/publish-sbom)?@"))
| ((.with // {}) | to_entries | map({"key": (.key | downcase), "value": (.value | to_string | trim)})) as $with
| (($we + $je + (((.env // {}) | select(tag == "!!map") | to_entries) // $opaque)) | map({"key": (.key | downcase), "value": (.value | to_string | trim)})) as $env
| ($with | map(select(.key == "upload-release-assets") | .value | downcase)) as $uploads
| ($env | map(select(.key == "input_upload-release-assets") | .value | downcase)) as $env_uploads
| select((($uploads | length) > 0 and (($uploads + $env_uploads) | all_c(. == "false"))) | not)
| (($with | map(select(.key == "release-ref-prefix") | .value)) + ($env | map(select(.key == "input_release-ref-prefix") | .value))) as $prefixes
| select($release or ($branch_only | not) or (($prefixes | all_c(. == "" or . == "refs/tags/")) | not))
| filename + ": job " + $job + ": sbom-release-upload: release asset upload needs contents: write"
