# Lists every anchore/sbom-action or publish-sbom step that can attach release assets in a job
# whose token lacks contents: write (a workflow_call job cannot see its caller and must grant it;
# pull_request-only workflows are skipped). Action defaults and INPUT_* env are not trusted because
# env scopes, runner OS key casing, GITHUB_ENV writes, and earlier steps can move them at run time;
# only step with is static. Runner input names and action refs are case-insensitive and
# core.getInput trims whitespace, so a step without contents: write is exempt only when with pins
# upload-release-assets to false, or on a branch-only push with release-ref-prefix pinned to refs/tags/.
explode(.)
| (.permissions // {}) as $wp
| ((.on | select(tag == "!!map") | keys) // (.on | [.] | flatten)) as $events
| ((.on | select(tag == "!!map") | .push) // {}) as $push
| ($events | any_c(. == "release" or . == "workflow_call")) as $release
| ($events | any_c(. == "push")) as $pushes
| ($push | ((has("branches") or has("branches-ignore")) and ((has("tags") or has("tags-ignore")) | not))) as $branch_only
| select($release or $pushes)
| .jobs | to_entries | .[] | .key as $job
| (.value.permissions // $wp) as $p
| select(($p == "write-all" or ($p | tag) == "!!map" and $p.contents == "write") | not)
| .value.steps // [] | .[]
| ((.uses // "") | downcase) as $uses
| select($uses | test("^anchore/sbom-action(/publish-sbom)?@"))
| ((.with // {}) | to_entries | map({"key": (.key | downcase), "value": (.value | to_string | trim)})) as $with
| ($with | map(select(.key == "upload-release-assets") | .value | downcase)) as $uploads
| select(($uploads | (length > 0 and all_c(. == "false"))) | not)
| ($with | map(select(.key == "release-ref-prefix") | .value)) as $prefixes
| select($release or ($branch_only | not) or (($prefixes | (length > 0 and all_c(. == "refs/tags/"))) | not))
| filename + ": job " + $job + ": sbom-release-upload: release asset upload needs contents: write, or with upload-release-assets: false, or on a branch-only trigger with release-ref-prefix: refs/tags/"
