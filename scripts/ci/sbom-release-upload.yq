# Lists every anchore/sbom-action or publish-sbom step that would attach release assets
# (upload-release-assets not disabled) in a job whose token lacks contents: write.
# The action attaches assets only on a release event or a push to a tag; a push filtered to
# branches alone never sees a tag, unless the step moves release-ref-prefix. A pull_request-only
# workflow is skipped.
# A workflow_call workflow cannot see its caller, so the called job must state permissions: contents: write.
explode(.)
| (.permissions // {}) as $wp
| ((.on | select(tag == "!!map") | keys) // (.on | [.] | flatten)) as $events
| ((.on | select(tag == "!!map") | .push) // {}) as $push
| ($events | any_c(. == "release" or . == "workflow_call")) as $release
| ($events | any_c(. == "push")) as $pushes
| ($push | ((has("branches") or has("branches-ignore")) and ((has("tags") or has("tags-ignore")) | not))) as $branch_only
| select($release or $pushes)
| .jobs | to_entries | .[] | .key as $job
| (.value.permissions // $wp) as $p
| select(($p == "write-all" or ($p | tag) == "!!map" and $p.contents == "write") | not)
| .value.steps // [] | .[]
| (.uses // "") as $uses
| select($uses | test("^anchore/sbom-action(/publish-sbom)?@"))
| ($uses | test("^anchore/sbom-action/publish-sbom@")) as $publish
| (.with."upload-release-assets") as $upload
| select($publish or $upload == null or ($upload | to_string | downcase | (. == "" or . == "true" or test("\\$\\{\\{"))))
| (.with."release-ref-prefix") as $prefix
| select($release or ($branch_only | not) or ($prefix != null and $prefix != "" and $prefix != "refs/tags/"))
| filename + ": job " + $job + ": sbom-release-upload: release asset upload needs contents: write"
