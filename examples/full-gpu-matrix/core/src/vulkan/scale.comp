#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Data { float v[]; } data;

layout(push_constant, std430) uniform Params {
    uint  n;
    float scale;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n)
        data.v[i] *= pc.scale;
}
