#include "dispatch_strategy.h"

#include "../gpu_dispatch_env.h"
#include "../gpu_dispatch_parse.h"

static const char *const k_strategy_names[] = {
    "direct", /* PROJ_{{NAME}}_DISPATCH_DIRECT = 0 */
    "graph",  /* PROJ_{{NAME}}_DISPATCH_GRAPH  = 1 */
    NULL,
};

Proj{{Name}}DispatchStrategy proj_{{name}}_select_strategy(const char *feature_name,
                                                          unsigned frame_w, unsigned frame_h)
{
    int idx = (int)PROJ_{{NAME}}_DISPATCH_DIRECT;
    const char *env = proj_gpu_dispatch_env_get("PROJ_{{NAME}}_DISPATCH");

    (void)frame_w;
    (void)frame_h;

    if (proj_gpu_dispatch_parse_env(env, feature_name, k_strategy_names, &idx))
        return (Proj{{Name}}DispatchStrategy)idx;

    return PROJ_{{NAME}}_DISPATCH_DIRECT;
}
