{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/horistes",
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "schedule": [
    "before 6am every weekday"
  ],
  "timezone": "Europe/Vienna",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "commitMessagePrefix": "chore(deps):",
  "branchPrefix": "renovate/",
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update actionlint and its image digest as one pair.",
      "managerFilePatterns": [
        "/^tools/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "ACTIONLINT_VERSION=(?<currentValue>[^\\s]+)\\nACTIONLINT_IMAGE_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rhysd/actionlint",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "ACTIONLINT_VERSION={{{newValue}}}\\nACTIONLINT_IMAGE_DIGEST={{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Update zizmor and its image digest as one pair.",
      "managerFilePatterns": [
        "/^tools/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "ZIZMOR_VERSION=(?<currentValue>[^\\s]+)\\nZIZMOR_IMAGE_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/zizmorcore/zizmor",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "ZIZMOR_VERSION={{{newValue}}}\\nZIZMOR_IMAGE_DIGEST={{{newDigest}}}"
    }
  ],
  "ignorePaths": [
    "subprojects/**",
    "build/**",
    "builddir*/**"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions minor+patch+digest bumps; digest-only is mechanical and CI catches drift.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions (minor + patch)",
      "schedule": [
        "before 6am on Monday"
      ]
    },
    {
      "description": "Major Action upgrades require human review — breaking changes possible.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "GitHub Actions (major)"
    },
    {
      "description": "Group pre-commit hook rev bumps; mechanical, lint catches drift.",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".github/workflows/reuse.yml",
        ".config/reuse/requirements.txt"
      ],
      "enabled": false
    }
  ]
}
