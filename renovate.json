{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/horistes",
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "schedule": [
    "before 6am every weekday"
  ],
  "timezone": "Europe/Vienna",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "commitMessagePrefix": "chore(deps):",
  "branchPrefix": "renovate/",
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the node pin pre-commit hands to nodeenv.",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "default_language_version:\\n  node: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Update actionlint and its image digest as one pair.",
      "managerFilePatterns": [
        "/^tools/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "ACTIONLINT_VERSION=(?<currentValue>[^\\s]+)\\nACTIONLINT_IMAGE_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rhysd/actionlint",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "ACTIONLINT_VERSION={{{newValue}}}\\nACTIONLINT_IMAGE_DIGEST={{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Update zizmor and its image digest as one pair.",
      "managerFilePatterns": [
        "/^tools/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "ZIZMOR_VERSION=(?<currentValue>[^\\s]+)\\nZIZMOR_IMAGE_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/zizmorcore/zizmor",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "ZIZMOR_VERSION={{{newValue}}}\\nZIZMOR_IMAGE_DIGEST={{{newDigest}}}"
    },
    {
      "currentValueTemplate": "HEAD",
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "praetor-workflow-engine-pin",
      "description": "praetor workflow engine commit pin: track the engine default branch",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?m)^[\\t ]*(PRAETOR_COMMIT)[\\t ]*[:=][\\t ]*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?[\\t ]*(#[^\\r\\n]*)?\\r?$",
        "(?m)^[\\t ]*(PRAETOR_REF)[\\t ]*[:=][\\t ]*[\"']?(?<currentDigest>[0-9a-fA-F]{7,40})[\"']?[\\t ]*(#[^\\r\\n]*)?\\r?$"
      ],
      "packageNameTemplate": "https://github.com/cordanaLLM/praetor"
    }
  ],
  "ignorePaths": [
    "subprojects/**",
    "build/**",
    "builddir*/**"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions minor+patch+digest bumps; digest-only is mechanical and CI catches drift.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions (minor + patch)",
      "schedule": [
        "before 6am on Monday"
      ]
    },
    {
      "description": "Major Action upgrades require human review — breaking changes possible.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "GitHub Actions (major)"
    },
    {
      "description": "Group pre-commit hook rev bumps; mechanical, lint catches drift.",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".github/workflows/reuse.yml",
        ".config/reuse/requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "praetor-managed engine: updates arrive in one coordinated adoption pull request",
      "matchPackageNames": [
        "github.com/cordanaLLM/praetor",
        "github.com/cordanaLLM/praetor/**",
        "github.com/cordanaLLM/praetor/cmd/standardsctl",
        "cordanaLLM/praetor",
        "cordanaLLM/praetor/**"
      ],
      "enabled": false
    }
  ]
}
